# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# ── Configuración propia (NO subir; se genera con scripts/write-config.mjs o se copia de la plantilla *.example.ts) ──
/src/app/core/firebase.config.ts
/src/app/core/push.config.ts

# ── Secretos y datos (NUNCA subir) ──
# Clave de cuenta de servicio de Firebase (solo debe vivir en la variable FIREBASE_SERVICE_ACCOUNT de Netlify)
*service-account*.json
*-firebase-adminsdk-*.json
.env
.env.*
# Copias de seguridad descargadas desde Ajustes (contienen datos de salud)
glucokid-backup*.json
*backup*.json

# Netlify CLI y paquetes de entrega
.netlify/
*.zip

